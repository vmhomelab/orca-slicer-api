# Bambu Studio variant of the slicer API.
#
# Same Node wrapper as ./Dockerfile; only the bundled slicer differs. The
# wrapper shells out to whatever binary ORCASLICER_PATH points at, and the
# Bambu Studio CLI accepts the same --load-settings / --load-filaments /
# --slice arguments. The profile resolver reads the bundled system profiles
# from ORCASLICER_RESOURCES_PATH, which has the same layout in Bambu Studio.
#
# Adapted from the Bambu Studio image in maziggy/orca-slicer-api
# (branch bambuddy/profile-resolver), AGPL-3.0 like this repository.
#
# Build:
#   docker build -f Dockerfile.bambu-studio \
#     --build-arg BAMBU_VERSION=02.08.02.61 -t bambu-studio-api .
#
# AMD64 only: Bambu Lab publishes no ARM64 Linux AppImage.
#
# The Ubuntu AppImage file name contains a build timestamp that cannot be
# derived from BAMBU_VERSION, so the download URL is resolved through the
# GitHub releases API at build time. Set BAMBU_APPIMAGE_URL to skip that
# lookup (for example when the unauthenticated API rate limit is exhausted).
# Bambu Studio 02.08.x links against webkit2gtk-4.1 and targets the
# Ubuntu 22.04 glibc, hence the 22.04 asset and 22.04 runtime image.
# The AppImage's magic bytes at ELF offset 8 are zeroed before extraction so
# the build also works under emulation (see the note in ./Dockerfile).

FROM node:22-bookworm AS build

ARG BAMBU_VERSION=02.08.02.61
ARG BAMBU_APPIMAGE_URL=
ARG TARGETARCH

WORKDIR /app

RUN set -eu; \
    if [ "$TARGETARCH" = "arm64" ]; then \
        echo "ARM64 is not supported: Bambu Studio has no official ARM64 AppImage." >&2; \
        exit 1; \
    fi; \
    url="$BAMBU_APPIMAGE_URL"; \
    if [ -z "$url" ]; then \
        echo "Resolving Bambu Studio v${BAMBU_VERSION} Ubuntu 22.04 AppImage..."; \
        url=$(curl -fsSL "https://api.github.com/repos/bambulab/BambuStudio/releases/tags/v${BAMBU_VERSION}" \
            | grep -oE 'https://[^"]*BambuStudio_ubuntu-?22\.04[^"]*\.AppImage' \
            | head -1); \
    fi; \
    if [ -z "$url" ]; then \
        echo "No Ubuntu 22.04 AppImage found for Bambu Studio v${BAMBU_VERSION}." >&2; \
        echo "Check the release, or pass --build-arg BAMBU_APPIMAGE_URL=<asset URL>." >&2; \
        exit 1; \
    fi; \
    echo "Downloading $url"; \
    curl -fL -o bambu.AppImage "$url"; \
    printf '\000\000\000' | dd of=bambu.AppImage bs=1 seek=8 count=3 conv=notrunc 2>/dev/null; \
    chmod +x bambu.AppImage; \
    ./bambu.AppImage --appimage-extract > /dev/null; \
    rm bambu.AppImage; \
    test -x squashfs-root/AppRun

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM ubuntu:22.04

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       nodejs \
       libgl1 libgl1-mesa-dri libegl1 libopengl0 libglu1-mesa libosmesa6 \
       libsm6 libice6 libmspack0 libsoup2.4-1 \
       libgtk-3-0 \
       libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
       libwebkit2gtk-4.1-0 \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/dist/src /app/dist
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/squashfs-root /app/squashfs-root

ENV PORT=3000
# The wrapper's slicer variables keep their OrcaSlicer names regardless of
# which slicer is bundled.
ENV ORCASLICER_PATH=/app/squashfs-root/AppRun
ENV ORCASLICER_RESOURCES_PATH=/app/squashfs-root/resources
ENV DATA_PATH=/app/data
ENV NODE_ENV=production

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "app/dist/index.js"]
